# === Supabase ===
# Lấy tại: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx...
# service_role — CHỈ dùng server-side, KHÔNG BAO GIỜ để lộ ra client/commit vào git
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx...

# === Google OAuth (qua Supabase Auth) ===
# Bật tại: Supabase Dashboard → Authentication → Providers → Google
# Cần tạo OAuth Client ID trên Google Cloud Console, redirect URI:
#   https://xxxxx.supabase.co/auth/v1/callback
# Không cần khai báo biến riêng ở đây — cấu hình hoàn toàn trong Supabase Dashboard.

# === Vercel KV (tùy chọn — cho /api/online, đếm người online) ===
KV_REST_API_URL=
KV_REST_API_TOKEN=

# === AI Provider — dùng cho công cụ "Định dạng bài viết bằng AI" ===
# Thử lần lượt Groq → Gemini → OpenRouter, dừng ở provider đầu tiên thành công.
# Chỉ cần cấu hình provider nào bạn có key — provider thiếu key sẽ tự bị bỏ qua.
# Không cần cấu hình cả 3, nhưng nên có ít nhất 1-2 cái để có fallback khi bị rate-limit.

# Groq (https://console.groq.com/keys) — nhanh, có free tier hào phóng
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter (https://openrouter.ai/keys) — cổng trung gian, truy cập nhiều model
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# URL site (dùng làm header Referer khi gọi OpenRouter)
NEXT_PUBLIC_SITE_URL=https://trexanh-tnvn.vercel.app
